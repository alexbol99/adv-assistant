# Local Docker/Postgres defaults for development only.
# Copy to .env and adjust values if needed.

POSTGRES_DB=adv_assistant
POSTGRES_USER=adv_assistant
POSTGRES_PASSWORD=change-me-local-only

# Phase 2 (Webhook + Task pipeline)
# Local development only. In staging/production, inject sensitive values from Secret Manager.
DATABASE_URL=postgresql+psycopg://adv_assistant:change-me-local-only@127.0.0.1:5432/adv_assistant
# Optional: dedicated migration URL (recommended to use migrator user in staging/prod)
ALEMBIC_DATABASE_URL=
VERIFY_TOKEN=change-me-verify-token
META_APP_SECRET=change-me-meta-app-secret
GRAPH_API_VERSION=v21.0
PHONE_NUMBER_ID=change-me-phone-number-id
WHATSAPP_ACCESS_TOKEN=change-me-whatsapp-access-token

# Task mode:
# - inline: local/dev (webhook processes task payload directly)
# - cloud: enqueue to Google Cloud Tasks
TASKS_MODE=inline
# Service role:
# - all: monolith mode (default; webhook + worker routes in one service)
# - webhook: enable /webhook only (plus shared admin/health)
# - worker: enable /tasks/process-message only (plus shared admin/health)
APP_SERVICE_ROLE=all
REPLAY_WINDOW_SECONDS=300
UNAUTHORIZED_REJECTION_WINDOW_MINUTES=60
UNAUTHORIZED_REJECTION_MESSAGE="You are not authorized to use this assistant. Please contact your administrator."
ADMIN_BASIC_USERNAME=admin
ADMIN_BASIC_PASSWORD=change-me-admin-password

# Cloud Tasks settings (required only for TASKS_MODE=cloud)
GCP_PROJECT_ID=ads-assistant-488908
GCP_REGION=me-west1
TASKS_REGION=me-central1
TASKS_QUEUE=adv-assistant-queue
TASKS_HANDLER_URL=https://your-cloud-run-url/tasks/process-message
TASKS_SERVICE_ACCOUNT_EMAIL=adv-assistant-tasks-caller@ads-assistant-488908.iam.gserviceaccount.com
TASKS_OIDC_AUDIENCE=https://your-cloud-run-url/tasks/process-message
TASKS_ALLOWED_SERVICE_ACCOUNT_EMAIL=adv-assistant-tasks-caller@ads-assistant-488908.iam.gserviceaccount.com

# Phase 4 (LLM boundary)
OPENAI_API_KEY=change-me-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_CLASSIFICATION_MODEL=gpt-5-mini
LLM_EXTRACTION_MODEL=gpt-5-mini
LLM_REPLY_MODEL=gpt-5-mini
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_INPUT_CHARS=2000
LLM_TRACE_ENABLED=false
LLM_TRACE_MAX_CHARS=4000

# Phase 5 (Enrichment pipeline)
ENRICHMENT_ENABLED=true
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
ENRICHMENT_HTTP_TIMEOUT_SECONDS=8

# Phase 7 (Ad generation)
# Gemini (preferred)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_SUBMIT_ATTEMPTS=4
GEMINI_RETRY_BASE_SECONDS=1.0

# Nano Banana (legacy fallback)
NANA_BANANA_API_KEY=
# Quickstart-style base URL (app calls /generate and /record-info?taskId=...)
NANA_BANANA_BASE_URL=https://api.nanobananaapi.ai/api/v1/nanobanana
# Optional explicit override for generate endpoint
NANA_BANANA_API_URL=
NANA_BANANA_MODEL=nanobanana-2
# Optional explicit override for status endpoint template; must include {job_id}
NANA_BANANA_STATUS_API_URL_TEMPLATE=
NANA_BANANA_GENERATION_TYPE=TEXTTOIAMGE
NANA_BANANA_NUM_IMAGES=1
NANA_BANANA_WATERMARK=
NANA_BANANA_TIMEOUT_SECONDS=20
NANA_BANANA_POLL_INITIAL_SECONDS=2
NANA_BANANA_POLL_MAX_SECONDS=10
NANA_BANANA_POLL_TIMEOUT_SECONDS=900
AD_RENDER_WIDTH=1920
AD_RENDER_HEIGHT=1080

# Phase 6 (Media lifecycle and storage)
# MEDIA_STORE_MODE:
# - noop: disable media upload (default)
# - gcs: upload operator photos/previews to Google Cloud Storage
# - s3: upload operator photos/previews to AWS S3
MEDIA_STORE_MODE=noop
MEDIA_GCS_BUCKET=
MEDIA_GCS_PUBLIC_BASE_URL=https://storage.googleapis.com
MEDIA_GCS_OBJECT_PREFIX=operator-photos
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
# Optional full public URL prefix for objects (for example: https://cdn.example.com/media)
MEDIA_S3_PUBLIC_BASE_URL=
MEDIA_S3_OBJECT_PREFIX=operator-photos
# Optional custom endpoint (for S3-compatible providers)
MEDIA_S3_ENDPOINT_URL=
MEDIA_LIFECYCLE_DAYS=90
MEDIA_VERIFY_LIFECYCLE_ON_STARTUP=false
WHATSAPP_MEDIA_TIMEOUT_SECONDS=15

# Phase 8 (CityScreen CMS publish - real contract)
CMS_CITYSCREEN_BASE_URL=https://play.eu.cityscreen.cloud
CMS_CITYSCREEN_APP_TOKEN=change-me-cityscreen-app-token
CMS_CITYSCREEN_CAMPAIGN_ID=157
CMS_CITYSCREEN_PLAYLIST_ID=139
