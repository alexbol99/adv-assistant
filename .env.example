# Local Docker/Postgres defaults for development only.
# Copy to .env and adjust values if needed.

POSTGRES_DB=adv_assistant
POSTGRES_USER=adv_assistant
POSTGRES_PASSWORD=change-me-local-only

# Phase 2 (Webhook + Task pipeline)
DATABASE_URL=postgresql+psycopg://adv_assistant:change-me-local-only@127.0.0.1:5432/adv_assistant
VERIFY_TOKEN=change-me-verify-token
META_APP_SECRET=change-me-meta-app-secret
GRAPH_API_VERSION=v21.0
PHONE_NUMBER_ID=change-me-phone-number-id
WHATSAPP_ACCESS_TOKEN=change-me-whatsapp-access-token

# Task mode:
# - inline: local/dev (webhook processes task payload directly)
# - cloud: enqueue to Google Cloud Tasks
TASKS_MODE=inline
REPLAY_WINDOW_SECONDS=300
UNAUTHORIZED_REJECTION_WINDOW_MINUTES=60
UNAUTHORIZED_REJECTION_MESSAGE=You are not authorized to use this assistant. Please contact your administrator.

# Cloud Tasks settings (required only for TASKS_MODE=cloud)
GCP_PROJECT_ID=ads-assistant-488908
GCP_REGION=me-west1
TASKS_REGION=me-central1
TASKS_QUEUE=adv-assistant-queue
TASKS_HANDLER_URL=https://your-cloud-run-url/tasks/process-message
TASKS_SERVICE_ACCOUNT_EMAIL=adv-assistant-tasks-caller@ads-assistant-488908.iam.gserviceaccount.com
TASKS_OIDC_AUDIENCE=https://your-cloud-run-url/tasks/process-message
TASKS_ALLOWED_SERVICE_ACCOUNT_EMAIL=adv-assistant-tasks-caller@ads-assistant-488908.iam.gserviceaccount.com

# Phase 4 (LLM boundary)
OPENAI_API_KEY=change-me-openai-key
OPENAI_BASE_URL=
LLM_CLASSIFICATION_MODEL=gpt-4o-mini
LLM_EXTRACTION_MODEL=gpt-4o-mini
LLM_REPLY_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_INPUT_CHARS=2000

# Phase 5 (Enrichment pipeline)
ENRICHMENT_ENABLED=true
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
ENRICHMENT_HTTP_TIMEOUT_SECONDS=8

# Phase 7 (Nano Banana ad generation; polling-only path)
NANA_BANANA_API_KEY=change-me-nana-banana-key
# Preferred: explicit endpoint URL
NANA_BANANA_API_URL=https://api.nanobananaapi.ai/api/v1/nanobanana/generate-2
# Optional fallback (if API URL is not set): app uses <base_url>/v1/generate
NANA_BANANA_BASE_URL=
NANA_BANANA_MODEL=nanobanana-2
# Required when base URL is not used; must include {job_id}
NANA_BANANA_STATUS_API_URL_TEMPLATE=https://api.nanobananaapi.ai/api/v1/nanobanana/jobs/{job_id}
NANA_BANANA_TIMEOUT_SECONDS=20
NANA_BANANA_POLL_INITIAL_SECONDS=2
NANA_BANANA_POLL_MAX_SECONDS=10
NANA_BANANA_POLL_TIMEOUT_SECONDS=900
AD_RENDER_WIDTH=1920
AD_RENDER_HEIGHT=1080
